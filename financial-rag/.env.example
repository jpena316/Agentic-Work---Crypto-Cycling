# ── Required API Keys ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PINECONE_API_KEY=pcsk_...

# ── Pinecone Index ─────────────────────────────────────────────────────────────
PINECONE_INDEX_NAME=financial-rag   # default: financial-rag
PINECONE_CLOUD=aws                  # default: aws
PINECONE_REGION=us-east-1           # default: us-east-1

# ── Embedding ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small   # default: text-embedding-3-small
EMBEDDING_DIMENSIONS=1536                # default: 1536

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=500    # default: 500
CHUNK_OVERLAP_TOKENS=75  # default: 75
